# Browser backend — the FALLBACK. The real home of these settings is Admin →
# Browser, which stores every backend (local, CDP, browserless.io, Browserbase,
# Kernel) and their credentials in the database, encrypted. The env values
# below are only used until something is saved there, and prefill that page.
#   browserless (default) → the session daemon connects to a remote CDP over wss
#                           (needs BROWSERLESS_URL/TOKEN below).
#   local                 → the daemon launches agent-browser's own installed
#                           browser (run `agent-browser install --with-deps` on
#                           the host/container first). BROWSERLESS_URL/TOKEN are
#                           then optional. Container-safe Chromium flags
#                           (--no-sandbox, --disable-dev-shm-usage) are added
#                           automatically; extra flags come from STEALTH_LAUNCH_ARGS.
BROWSER_MODE=browserless
# Prefill for the hosted providers on Admin → Browser (optional):
# BROWSERLESS_API_KEY=   BROWSERLESS_API_URL=https://production-sfo.browserless.io
# BROWSERBASE_API_KEY=
# KERNEL_API_KEY=        KERNEL_HEADLESS=true  KERNEL_STEALTH=false  KERNEL_TIMEOUT_SECONDS=300
# KERNEL_PROFILE_NAME=   KERNEL_PROFILE_SAVE_CHANGES=false

# Key for the encrypted settings (browser credentials). 64 hex chars, e.g.
# `openssl rand -hex 32`. If unset, a random one is generated and persisted to
# DATA_DIR/secrets-key — set this to keep the key off the data volume. Losing
# or changing it makes the stored browser settings unreadable (the app then
# falls back to the env values above; re-enter them on Admin → Browser).
# SECRETS_KEY=

# --- AI scenario builder (the "✨ AI task" button on a scenario) ---
# Vercel AI Gateway key; without it the button is disabled. Model + URL follow
# agent-browser's own chat defaults and can be overridden.
# AI_GATEWAY_API_KEY=vck_...
# AI_GATEWAY_MODEL=anthropic/claude-sonnet-4.6
# AI_GATEWAY_URL=https://ai-gateway.vercel.sh

# --- Email notifications (Resend) ---
# API key from https://resend.com/api-keys. Empty → email notifications disabled.
# RESEND_API_KEY=re_...
# Sender address. The domain must be verified in Resend — the default
# onboarding@resend.dev sandbox only delivers to the Resend account owner.
# EMAIL_FROM=Energie Agent <alerts@yourdomain.com>
# Where replies go (the sender address usually has no inbox). Any address
# works — no Resend verification needed. Empty → no Reply-To header.
# EMAIL_REPLY_TO=you@example.com
# Public base URL of this app, used for "view run" links in emails.
# APP_BASE_URL=https://agent.example.com

# --- App login gate (single shared credential in front of the whole app) ---
# Set APP_AUTH_ENABLED=false to disable the login page entirely.
APP_AUTH_ENABLED=true
APP_AUTH_USER=jw@ikkoop.nl
APP_AUTH_PASS=jw@ikkoop.nl
# Optional: pin the session-signing secret. If unset, a random one is generated
# and persisted to DATA_DIR/auth-secret (changing it logs everyone out).
# APP_AUTH_SECRET=

# Optional: pin the browser executable in local mode (else agent-browser
# auto-detects system Chrome / the `agent-browser install` copy).
# AGENT_BROWSER_EXECUTABLE_PATH=/usr/bin/chromium

# Only used when BROWSER_MODE=browserless.
BROWSERLESS_URL=wss://browserless.chatle.nl
BROWSERLESS_TOKEN=replace-me
DATA_DIR=./data
PORT=3011
WEB_ORIGIN=http://localhost:5173
AGENT_BROWSER_BIN=agent-browser
SESSION_IDLE_TTL_MS=300000

# --- Stealth (Cloudflare / WAF evasion at the browser-fingerprint layer) ---
# Like the backends, these are edited on Admin → Browser and stored in the
# database; the values here are the defaults until something is saved there.
# Which backends honour what: launch args → local + CDP (browserless);
# ignore-default-args → CDP only; user agent + init script → every backend
# (agent-browser applies them on the page), though the hosted providers have
# ignored the user-agent override in practice.
STEALTH_ENABLED=true
# Stripped of "HeadlessChrome", matches a real Win10 + Chrome 148 UA. Current
# strings: https://www.whatismybrowser.com/guides/the-latest-user-agent/chrome
STEALTH_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36
# Whitespace-separated Chromium launch args. Each token is a single flag —
# values that themselves contain commas (e.g. --disable-features=A,B) stay intact.
# Local: passed as AGENT_BROWSER_ARGS. CDP: folded into the wss `launch` query.
STEALTH_LAUNCH_ARGS=--disable-blink-features=AutomationControlled --disable-features=IsolateOrigins,site-per-process --no-default-browser-check --no-first-run
# Default args browserless should strip from the Chromium launch — removes the
# "Chrome is being controlled by automated test software" banner and the
# navigator.webdriver flag. CDP backend only (agent-browser has no equivalent).
STEALTH_IGNORE_DEFAULT_ARGS=--enable-automation
# Init script run before every navigation. Empty to disable. The default points
# at apps/server/stealth/init.js (navigator.webdriver, plugins, WebGL, etc.).
# STEALTH_INIT_SCRIPT=
